# syntax=docker/dockerfile:1
#
# Front-end estático para demonstração na VPS (fora do pacote de depósito INPI).
# PUBLIC_URL em tempo de build: frontend/src/lib/api.ts usa import.meta.env.VITE_API_URL.

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":80"]
