# Copie para deploy/.env: cp deploy/.env.example deploy/.env
# Todas as variáveis abaixo são obrigatórias para o compose de produção
# (portas usam sintaxe :? no docker-compose.prod.yml).

# ── Domínio público (DNS A/AAAA apontando para a VPS) ───────────────────────
DOMINIO=ladder.exemplo.com.br
PUBLIC_URL=https://ladder.exemplo.com.br

# ── Portas no host (somente 127.0.0.1 — o Caddy do host faz o proxy) ─────────
BACKEND_PORT=8010
FRONTEND_PORT=3010

# ── CORS do backend (mesma origem que PUBLIC_URL quando há um único domínio) ─
CORS_ORIGINS=https://ladder.exemplo.com.br

# ── Backend ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Build frio do ESP-IDF pode passar de 300 s com CPUs limitadas na VPS.
COMPILE_TIMEOUT_ESP32_S=900
BACKEND_CPUS=1.5
BACKEND_MEM=4g
