# Copie para .env: cp .env.example .env
# Todas as variáveis têm padrão no docker-compose.yml; ajuste só o que precisar.

# ── Portas expostas no host ──────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── URL da API como vista pelo navegador ─────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Origens autorizadas no CORS do backend (separadas por vírgula) ───────────
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info

# ── MATIEC ───────────────────────────────────────────────────────────────────
# Definidos pela imagem do backend (ver backend/Dockerfile).
# Sobrescreva apenas para rodar o backend fora do Docker.
# MATIEC_IEC2C_PATH=/usr/local/bin/iec2c
# MATIEC_LIB_DIR=/usr/local/share/matiec/lib
